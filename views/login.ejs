<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>SO - Login</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-950 text-zinc-100 flex items-center justify-center h-screen">
    <div class="bg-zinc-900 border border-zinc-800 p-8 rounded-2xl max-w-md w-full">
        <h2 class="text-2xl font-extrabold mb-6 text-center text-amber-400">Welcome Back to SO</h2>
        <form action="/login" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs text-zinc-400 mb-1">Username</label>
                <input type="text" name="username" required class="w-full bg-zinc-950 border border-zinc-800 rounded-xl p-3 text-sm focus:outline-none focus:border-amber-400">
            </div>
            <div>
                <label class="block text-xs text-zinc-400 mb-1">Password</label>
                <input type="password" name="password" required class="w-full bg-zinc-950 border border-zinc-800 rounded-xl p-3 text-sm focus:outline-none focus:border-amber-400">
            </div>
            <button type="submit" class="w-full bg-amber-400 text-zinc-950 py-3 rounded-xl font-bold hover:bg-amber-300 transition">Log In</button>
        </form>
        <p class="text-center text-sm text-zinc-500 mt-4">Don't have an account? <a href="/register" class="text-amber-400">Sign Up</a></p>
    </div>
</body>
</html>
